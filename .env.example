# Ket noi toi MySQL cua do an (database QuanLyKhachSan).
# Copy file nay thanh .env.local roi sua lai user/password cho may cua ban.
#
#   mysql://<user>:<password>@<host>:<port>/<database>
#
# Neu mat khau co ky tu dac biet (@ : / ...) thi phai URL-encode.
DATABASE_URL="mysql://root:@127.0.0.1:3306/QuanLyKhachSan"
